// 심플한교회관리 — 데이터 모델
// 교적 · 회계 · 기부금영수증 · 교회역사
//
// 여러 교회가 한 서버를 함께 씁니다. 교회별 자료는 churchId 로 완전히 분리되며,
// 모든 조회는 로그인한 사람이 속한 교회로 범위가 제한됩니다.
//
// 데이터베이스는 PostgreSQL 입니다. Supabase, Neon 같은 관리형 서비스나
// 직접 띄운 Postgres 모두 DATABASE_URL 만 바꾸면 그대로 동작합니다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 교회
// ─────────────────────────────────────────────

model Church {
  id   String @id @default(cuid())
  name String

  regNo          String? // 고유번호 / 사업자등록번호
  representative String?
  postalCode     String?
  address        String?
  phone          String?
  logoUrl        String?
  sealUrl        String? // 직인 이미지

  receiptAutoIssue     Boolean @default(true) // 신청 즉시 자동 발급
  // 체험용 교회 (로그인 화면의 '체험해 보기', 앱 심사용). 매일 새 예시 자료로 다시 만든다.
  isDemo               Boolean @default(false)
  joinOpen             Boolean @default(true) // 성도의 가입 신청 허용 여부
  showBalanceToMembers Boolean @default(false) // 성도 화면에 교회 잔액(금액만) 보여 주기

  // 은행 입출금 알림 받기 (휴대폰 단축어가 문자를 보내는 주소의 비밀 열쇠)
  bankToken           String? @unique
  bankAutoRecord      Boolean @default(false) // 알아볼 수 있는 입출금은 확인 없이 바로 장부에 기록
  bankIncomeAccountId String? // 자동 기록할 때 입금에 쓸 기본 헌금 항목

  users         User[]
  members       Member[]
  districts     District[]
  households    Household[]
  accounts      Account[]
  offerings     Offering[]
  expenses      Expense[]
  budgets       Budget[]
  receipts      DonationReceipt[]
  historyEvents HistoryEvent[]
  historyPhotos HistoryPhoto[]
  auditLogs     AuditLog[]
  bankAlerts    BankAlert[]
  attendance    AttendanceRecord[]
  visits        Visit[]
  posts         Post[]
  chatMessages  ChatMessage[]
  setlists      Setlist[]
  reports       ContentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ─────────────────────────────────────────────
// 사용자 · 권한
// role   : ADMIN(관리자) | FINANCE(회계) | PASTOR(교역자) | MEMBER(성도)
// status : PENDING(승인대기) | ACTIVE(사용중) | REJECTED(거절) | SUSPENDED(정지)
// ─────────────────────────────────────────────

model User {
  id       String  @id @default(cuid())
  loginId  String  @unique
  password String
  name     String
  phone    String?

  role   String @default("MEMBER")
  status String @default("PENDING")

  mustChangePw Boolean   @default(false)
  lastLoginAt  DateTime?

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  memberId String? @unique
  member   Member? @relation("MemberAccount", fields: [memberId], references: [id], onDelete: SetNull)

  // 가입 신청 처리 기록
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?     @relation("Approver", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[]    @relation("Approver")
  rejectReason  String?

  pushSubscriptions PushSubscription[]

  offeringsCreated Offering[]        @relation("OfferingCreator")
  expensesCreated  Expense[]         @relation("ExpenseCreator")
  receiptsIssued   DonationReceipt[] @relation("ReceiptIssuer")
  auditLogs        AuditLog[]
  visitsWritten    Visit[]           @relation("VisitWriter")

  // 교회 소통(사진·댓글·채팅) — 계정을 지우면 올린 글도 함께 지워진다.
  communityAgreedAt DateTime?
  posts             Post[]
  postComments      PostComment[]
  chatMessages      ChatMessage[]
  reportsMade       ContentReport[] @relation("Reporter")
  blocking          UserBlock[]     @relation("Blocker")
  blockedBy         UserBlock[]     @relation("Blocked")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, status])
  @@index([churchId, role])
}

// ─────────────────────────────────────────────
// 교적 (교구 · 가정 · 교인)
// ─────────────────────────────────────────────

model District {
  id         String  @id @default(cuid())
  name       String
  leaderName String?
  sortOrder  Int     @default(0)

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  households Household[]
  members    Member[]

  createdAt DateTime @default(now())

  @@unique([churchId, name])
}

model Household {
  id            String  @id @default(cuid())
  name          String
  postalCode    String?
  address       String?
  addressDetail String?
  phone         String?
  note          String?

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  members Member[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId])
}

model Member {
  id        String  @id @default(cuid())
  code      String // 교적번호 (교회 안에서만 고유)
  name      String
  nameHanja String?
  photoUrl  String?
  gender    String? // M | F

  birthDate    DateTime?
  birthIsLunar Boolean   @default(false)

  phone         String?
  email         String?
  postalCode    String?
  address       String?
  addressDetail String?

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  householdId  String?
  household    Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  householdRel String? // 세대주와의 관계: 본인/배우자/자녀/부모/형제

  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  position String? // 목사/전도사/장로/권사/안수집사/서리집사/성도
  status   String  @default("ACTIVE") // ACTIVE 재적 | INACTIVE 장기결석 | TRANSFERRED 이명 | DECEASED 소천

  registeredAt  DateTime? // 등록일
  catechumenAt  DateTime? // 학습
  baptizedAt    DateTime? // 세례
  confirmedAt   DateTime? // 입교
  transferredAt DateTime?
  transferTo    String?
  deceasedAt    DateTime?

  job            String?
  previousChurch String?
  note           String?

  offerings   Offering[]
  coOfferings OfferingGiver[]
  receipts    DonationReceipt[]
  user        User?             @relation("MemberAccount")
  attendance  AttendanceCheck[]
  visits      Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, code])
  @@index([churchId, name])
  @@index([churchId, status])
  @@index([householdId])
}

// ─────────────────────────────────────────────
// 회계 (계정과목 · 헌금 · 지출 · 예산)
// ─────────────────────────────────────────────

model Account {
  id   String @id @default(cuid())
  code String
  name String
  type String // INCOME | EXPENSE

  category   String? // 대분류 (예: 경상비, 사역비)
  isOffering Boolean @default(false) // 헌금 항목 여부
  deductible Boolean @default(true) // 기부금영수증 공제대상 여부
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  offerings Offering[]
  expenses  Expense[]
  budgets   Budget[]

  createdAt DateTime @default(now())

  @@unique([churchId, code])
  @@index([churchId, type])
}

model Offering {
  id     String   @id @default(cuid())
  date   DateTime
  amount Int

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  memberId  String?
  member    Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  donorName String? // 미등록 헌금자 이름 (교인과 이은 뒤에도 통장·엑셀에 적힌 이름 그대로 둔다)

  // 함께 드린 다른 교인들 (예: "김동진최창일" → memberId 김동진, coGivers 최창일)
  coGivers        OfferingGiver[]
  // 사람이 헌금자를 직접 골랐으면 true. 이름으로 자동 연결할 때 건드리지 않는다.
  giversConfirmed Boolean         @default(false)

  method String  @default("CASH") // CASH 현금 | TRANSFER 계좌이체 | CARD 카드
  note   String?

  bankAlert BankAlert?

  createdById String?
  createdBy   User?   @relation("OfferingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, date])
  @@index([memberId])
  @@index([accountId])
}

// 헌금을 함께 드린 교인 (대표 헌금자 Offering.memberId 말고 나머지)
// 교인별 헌금 내역에는 함께 드린 헌금도 보이지만, 기부금영수증은 대표 헌금자에게만 들어간다.
model OfferingGiver {
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([offeringId, memberId])
  @@index([memberId])
}

model Expense {
  id     String   @id @default(cuid())
  date   DateTime
  amount Int

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  payee       String? // 지급처
  method      String  @default("TRANSFER")
  description String?
  receiptUrl  String? // 영수증 사진
  note        String?

  bankAlert BankAlert?

  createdById String?
  createdBy   User?   @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, date])
  @@index([accountId])
}

model Budget {
  id     String @id @default(cuid())
  year   Int
  amount Int

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([year, accountId])
  @@index([churchId, year])
}

// ─────────────────────────────────────────────
// 기부금영수증 (성도 온라인 신청 · 발급)
// status: REQUESTED 신청 | ISSUED 발급완료 | REJECTED 반려 | CANCELED 취소
// ─────────────────────────────────────────────

model DonationReceipt {
  id        String @id @default(cuid())
  receiptNo String
  year      Int

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // 신청 시점 기부자 정보 스냅샷 (주민등록번호는 암호화 저장)
  donorName     String
  donorRegNoEnc String?
  donorAddress  String?
  donorPhone    String?

  totalAmount Int    @default(0)
  status      String @default("REQUESTED")

  requestedAt  DateTime  @default(now())
  issuedAt     DateTime?
  issuedById   String?
  issuedBy     User?     @relation("ReceiptIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  rejectReason String?
  note         String?

  items DonationReceiptItem[]

  @@unique([memberId, year])
  @@unique([churchId, receiptNo])
  @@index([churchId, status])
  @@index([churchId, year])
}

model DonationReceiptItem {
  id String @id @default(cuid())

  receiptId String
  receipt   DonationReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  accountName  String
  donationCode String @default("41") // 41: 종교단체 기부금
  amount       Int
  count        Int    @default(0)
}

// ─────────────────────────────────────────────
// 교회 역사
// ─────────────────────────────────────────────

model HistoryEvent {
  id           String   @id @default(cuid())
  date         DateTime
  dateIsApprox Boolean  @default(false)
  title        String
  category     String   @default("GENERAL") // FOUNDING | BUILDING | ORDINATION | MISSION | EVENT | PASTOR | GENERAL
  content      String?
  pinned       Boolean  @default(false)

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  photos HistoryPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, date])
  @@index([churchId, category])
}

model HistoryPhoto {
  id        String    @id @default(cuid())
  url       String
  caption   String?
  takenAt   DateTime?
  sortOrder Int       @default(0)

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  eventId String?
  event   HistoryEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([churchId])
}

// ─────────────────────────────────────────────
// 출석
// 예배(모임) 한 번이 출석부 하나다. 교인별 체크와, 교인이 아닌 방문자 수를 함께 적는다.
// service : SUNDAY(주일예배) | WEDNESDAY(수요예배) | FRIDAY(금요기도회)
//           DAWN(새벽기도) | SCHOOL(주일학교) | YOUTH(청년부) | SMALL(구역·목장)
// ─────────────────────────────────────────────

model AttendanceRecord {
  id           String   @id @default(cuid())
  date         DateTime
  service      String   @default("SUNDAY")
  visitorCount Int      @default(0) // 교적에 없는 방문자·새신자 수
  note         String?

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  checks AttendanceCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, date, service])
  @@index([churchId, service, date])
}

model AttendanceCheck {
  id String @id @default(cuid())

  recordId String
  record   AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([recordId, memberId])
  @@index([memberId])
}

// ─────────────────────────────────────────────
// 심방 · 상담 기록
// 교역자와 관리자만 보고 쓴다. (회계 담당자는 볼 수 없다)
// kind : VISIT(심방) | COUNSEL(상담) | CALL(전화) | HOSPITAL(병문안) | ETC(기타)
// ─────────────────────────────────────────────

model Visit {
  id      String   @id @default(cuid())
  date    DateTime
  kind    String   @default("VISIT")
  content String
  prayer  String? // 기도제목

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("VisitWriter", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, date])
  @@index([memberId, date])
}

// ─────────────────────────────────────────────
// 은행 입출금 알림
// 교회 통장의 입출금 문자를 휴대폰 단축어가 서버로 보내면 여기에 쌓인다.
// 회계 담당자가 확인하고 헌금·지출로 기록하거나, 규칙에 따라 자동으로 기록된다.
// direction : IN(입금) | OUT(출금)
// status    : PENDING(확인 대기) | RECORDED(장부 반영) | IGNORED(장부와 무관)
// source    : SHORTCUT(휴대폰 단축어) | MANUAL(직접 붙여넣기)
//             | BALANCE(문자는 없었지만 앞뒤 문자의 잔액 차이로 찾아낸 거래)
// ─────────────────────────────────────────────

model BankAlert {
  id           String   @id @default(cuid())
  direction    String
  amount       Int
  balance      Int? // 거래 후 잔액
  counterparty String? // 보낸 사람 / 받는 곳
  bankName     String?
  occurredAt   DateTime
  rawText      String
  source       String   @default("SHORTCUT")
  status       String   @default("PENDING")
  dedupKey     String // 같은 문자가 두 번 들어와도 한 번만 쌓이도록

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  offeringId String?   @unique
  offering   Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  expenseId  String?   @unique
  expense    Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, dedupKey])
  @@index([churchId, status, occurredAt])
  @@index([churchId, counterparty])
}

// ─────────────────────────────────────────────
// 푸시 알림 구독
// 브라우저(또는 홈 화면에 추가한 앱) 하나가 구독 하나에 해당한다.
// ─────────────────────────────────────────────

model PushSubscription {
  id       String @id @default(cuid())
  endpoint String @unique
  p256dh   String
  auth     String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label      String? // 어떤 기기인지 알아보기 위한 메모
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ─────────────────────────────────────────────
// 감사 로그
// ─────────────────────────────────────────────

model AuditLog {
  id       String  @id @default(cuid())
  action   String // CREATE | UPDATE | DELETE | ISSUE ...
  entity   String // Offering | Expense | Member ...
  entityId String?
  summary  String?

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([churchId, createdAt])
  @@index([churchId, entity])
}

// ─────────────────────────────────────────────
// 교회 소통: 사진 나눔 · 댓글 · 전체 채팅 · 이번 주 콘티 · 신고/차단
// ─────────────────────────────────────────────

model Post {
  id     String  @id @default(cuid())
  body   String  @default("")
  pinned Boolean @default(false) // 공지: 사진 화면 맨 위에 고정 (교역자·관리자만)

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  photos   PostPhoto[]
  comments PostComment[]

  createdAt DateTime @default(now())

  @@index([churchId, createdAt])
}

model PostPhoto {
  id        String @id @default(cuid())
  url       String
  sortOrder Int    @default(0)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostComment {
  id   String @id @default(cuid())
  body String

  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model ChatMessage {
  id   String @id @default(cuid())
  body String

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([churchId, createdAt])
}

// 이번 주 콘티(찬양 목록). 곡마다 유튜브 링크를 붙인다.
model Setlist {
  id          String   @id @default(cuid())
  title       String
  serviceDate DateTime
  note        String?
  playlistUrl String? // 이미 만들어 둔 유튜브 재생목록 주소(선택)

  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  songs SetlistSong[]

  createdAt DateTime @default(now())

  @@index([churchId, serviceDate])
}

model SetlistSong {
  id         String  @id @default(cuid())
  sortOrder  Int     @default(0)
  title      String
  musicKey   String?
  youtubeUrl String?

  setlistId String
  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
}

// 신고. kind: POST | COMMENT | CHAT
model ContentReport {
  id        String   @id @default(cuid())
  kind      String
  targetId  String
  reason    String?
  excerpt   String? // 신고 당시 글 내용 (지워진 뒤에도 기록이 남도록)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  churchId   String
  church     Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([churchId, resolved])
}

model UserBlock {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}
