{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "framework": "nextjs",
  "buildCommand": "node scripts/vercel-build.mjs",
  "crons": [
    {
      "path": "/api/keepalive?at=morning",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/keepalive?at=evening",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/demo/reset",
      "schedule": "0 19 * * *"
    }
  ]
}
