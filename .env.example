# 이 파일을 .env 로 복사한 뒤 값을 채워 사용하세요.

# SQLite 데이터베이스 파일 경로
DATABASE_URL="file:./dev.db"

# 세션 토큰 서명 및 민감정보 암호화 키 (32자 이상 임의 문자열)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="여기에-충분히-긴-임의-문자열을-넣으세요"

# 업로드 파일 저장 위치 (비워 두면 ./data/uploads)
# UPLOAD_DIR="/var/lib/church/uploads"

# 푸시 알림 (선택) — 없으면 알림 기능만 꺼지고 나머지는 정상 동작합니다.
# 키 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:교회이메일@example.com"
