# 이 파일을 .env 로 복사한 뒤 값을 채워 사용하세요.

# ── 데이터베이스 (필수) ─────────────────────────────
# PostgreSQL 연결 주소입니다.
#
# Supabase 를 쓰신다면:
#   대시보드 → Project Settings → Database → Connection string → URI
#   서버리스(Vercel)에 올릴 때는 6543 포트의 Transaction pooler 주소를 쓰세요.
#
# 노트북에서 개발만 할 때는 docker compose 로 띄운 주소를 그대로 쓰면 됩니다:
#   postgresql://postgres:devpass@localhost:5432/church?schema=public
DATABASE_URL=""

# 연결 풀 크기. Supabase 무료 요금제는 연결 수가 적으니 작게 두세요.
# DATABASE_POOL_MAX="5"

# ── 보안 키 (필수) ──────────────────────────────────
# 로그인 세션 서명과 주민등록번호 암호화에 함께 쓰입니다.
# 생성: openssl rand -hex 32
#
# 한번 정하면 절대 바꾸지 마세요. 바꾸면 저장된 주민등록번호를 읽을 수 없습니다.
APP_SECRET=""

# ── 사진 저장 (선택) ────────────────────────────────
# Supabase Storage 를 쓰면 아래 세 값을 채우세요.
# 비워 두면 서버 디스크(data/uploads)에 저장합니다.
#
# Vercel 처럼 디스크에 파일을 쓸 수 없는 곳에 올릴 때는 반드시 채워야 합니다.
#   대시보드 → Project Settings → API 에서 확인
#   버킷은 Storage 에서 만들고 반드시 '비공개(Private)' 로 두세요.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="church-uploads"

# Supabase 를 쓰지 않을 때 사진을 저장할 폴더 (비우면 ./data/uploads)
# UPLOAD_DIR="/var/lib/church/uploads"

# ── 푸시 알림 (선택) ────────────────────────────────
# 없으면 알림 기능만 꺼지고 나머지는 정상 동작합니다.
# 키 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:교회이메일@example.com"
